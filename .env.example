# Token de acesso da Instagram Messaging API (Meta Graph API)
IG_ACCESS_TOKEN=

# Token que voce define para validar o webhook na Meta (hub.verify_token)
IG_VERIFY_TOKEN=

# Chave da API da Anthropic (Claude) usada para gerar respostas personalizadas
ANTHROPIC_API_KEY=

# Chave da API da OpenAI usada para gerar as imagens dos criativos (DALL-E 3)
OPENAI_API_KEY=

# Porta usada localmente (Railway define automaticamente em producao)
PORT=5000
